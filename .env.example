# Required by compose.production.yml. Copy to a secret-managed .env; never commit real values.
POSTGRES_DB=seo_loodoi
POSTGRES_USER=seo_loodoi
POSTGRES_PASSWORD=replace-with-a-long-random-secret
PUBLIC_API_URL=https://app.example.com
PUBLIC_WEB_URL=https://app.example.com
WEB_PORT=8080
APPLY_MIGRATIONS=false
REQUIRE_CONFIRMED_EMAIL=false

# Optional immutable registry tags. Defaults build local images when omitted.
SEO_LOODOI_API_IMAGE=seo-loodoi-api:local
SEO_LOODOI_WEB_IMAGE=seo-loodoi-web:local

# Optional provider configuration. Disabled providers must keep working without credentials.
AI_ENABLED=false
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
SearchConsole__ClientId=
SearchConsole__ClientSecret=
SearchConsole__RedirectUri=https://app.example.com/api/integrations/google/search-console/callback

EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
